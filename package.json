{
  "name": "ahibizz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "owner:check": "node scripts/initial-owner.mjs --check",
    "owner:activate": "node scripts/initial-owner.mjs --activate",
    "check": "biome check . && tsc --noEmit && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "better-auth": "1.7.23",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
