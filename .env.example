# Copy locally to .env.local. Enter real values only in OctaDeploy environment settings.
DATABASE_URL=
APP_URL=http://localhost:3000
# Authentication stays unavailable until all values and the database are configured.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional EUR bank receiver for Ahi Credits. Leaving this empty hides bank top-ups.
# Use a confirmed N26 Freelancer or Wise Business account. Set bank.name to N26 or Wise.
# Expected JSON: enabled, commercialConfirmed, recipient, bank { id, label, name, currency, iban, optional bic and address }.
AHIBIZZ_CREDIT_BANK_TRANSFER=
# Restrict new Ahi Credit top-ups to bank transfers.
AHIBIZZ_CREDIT_TOP_UP_BANK_ONLY=false
# Require credits for new platform purchases and bank transfers for credit top-ups.
AHIBIZZ_PLATFORM_CREDITS_ONLY=false

# Enable embedded credit top-ups only for a merchant approved to sell Ahi credits by card.
PAYPAL_CREDIT_CARD_TOPUPS_ENABLED=false
# Optional live pilot for the authenticated AhiBizz platform owner only.
PAYPAL_CREDIT_CARD_TOPUPS_PILOT_OWNER=false
