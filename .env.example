# Copy locally to .env.local. Enter real values only in OctaDeploy environment settings.
DATABASE_URL=
APP_URL=http://localhost:3000
# Authentication stays unavailable until all values and the database are configured.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Wise Business receiver for Ahi Credits. Leaving this empty hides bank top-ups.
# Use only confirmed Wise Business account details in EUR.
# Expected JSON: enabled, commercialConfirmed, recipient, bank { id, label, name, currency, iban, optional bic and address }.
AHIBIZZ_CREDIT_BANK_TRANSFER=
