# Copy locally to .env.local. Enter real values only in OctaDeploy environment settings.
DATABASE_URL=
APP_URL=http://localhost:3000
# Authentication stays unavailable until all values and the database are configured.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional. The moment the app opens to everyone, as a full instant with its offset, for example
# 2026-12-02T12:00:00+01:00. Until then a visitor who is not signed in sees "Uskoro otvaramo".
# Empty uses the day kept in src/lib/opening.ts; "off" switches the page off.
AHIBIZZ_OPENING_AT=
